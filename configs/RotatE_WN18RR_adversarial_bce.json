{
  "model": "RotatE",
  "dataset": "WN18RR",
  "model_loss_path": "models/losses/adversarial_bce_loss.py",
  "model_strategy_path": "models/strategies/negsamp_strategy.py",
  "model_sampler_path": "models/samplers/filtered_1_to_n_sampler.py",
  "head_eval_mode": "rt_forward",
  "dim": 500,
  "adversarial_training": true,
  "adversarial_temperature": 0.5,
  "margin": 6.0,
  "batch_size": 512,
  "epochs": 400,
  "optim": "adam",
  "lr": 5e-05,
  "weight_decay": 0.0,
  "warm_up_steps": 40000,
  "lr_decay_factor": 0.1,
  "lr_decay_preserve_optimizer": false,
  "shuffle_train": true,
  "use_amp": false,
  "n_sample": 1024,
  "training_cadence": "epoch",
  "epoch_per_eval": 5,
  "test_batch_size": 8,
  "score_query_chunk_size": 256,
  "eval_candidate_chunk_size": 2048,
  "eval_entity_chunk_size": 4096,
  "early_stopping_patience": 10,
  "early_stopping_min_epochs": 50,
  "early_stopping_min_metric": 0.05,
  "max_to_keep": 0,
  "output_dir_prefix": "logs/RotatE_WN18RR_adversarial_bce",
  "tie_handling": "rounded_mean_rank",
  "tie_rtol": 0.0001,
  "tie_atol": 1e-05,
  "normalize_lp_scores": false,
  "neg_score_chunk_size": 256
}
