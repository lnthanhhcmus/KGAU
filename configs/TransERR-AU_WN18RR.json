{
  "model": "TransERR-AU",
  "dataset": "WN18RR",
  "model_loss_path": "models/losses/au_loss.py",
  "model_strategy_path": "models/strategies/kgau_strategy.py",
  "model_sampler_path": "",
  "head_eval_mode": "hr_inverse",
  "kgau_bidirectional": false,
  "uniformity_full_pdist": false,
  "max_uniformity_samples": 0,
  "normalize_au_vectors": true,
  "gamma_q": 1.0,
  "gamma_t": 1.0,
  "gamma_h": 0.0,
  "gamma_ent": 1.0,
  "gamma_cross": 0.0,
  "average_uniformity_terms": true,
  "entity_uniformity_batch": true,
  "au_deduplicate": false,
  "tuni": 4,
  "dim": 128,
  "triple_relation_embedding": true,
  "adversarial_training": true,
  "adversarial_temperature": 0.5,
  "margin": 12.0,
  "epsilon": 2.0,
  "add_reciprocal_relations": true,
  "batch_size": 2048,
  "training_cadence": "epoch",
  "epochs": 1200,
  "warm_up_ratio": [
    0.1,
    0.5,
    0.8
  ],
  "lr_decay_factor": 0.1,
  "optim": "adam",
  "lr": 0.001,
  "weight_decay": 0.0,
  "shuffle_train": true,
  "use_amp": false,
  "test_eval_last": true,
  "test_eval_best": true,
  "n_sample": 0,
  "regularization": 0.4,
  "valid_steps": 2000,
  "save_checkpoint_steps": 2000,
  "test_batch_size": 8,
  "score_query_chunk_size": 256,
  "eval_candidate_chunk_size": 2048,
  "eval_entity_chunk_size": 4096,
  "max_to_keep": 0,
  "output_dir_prefix": "logs/TransERR-AU_WN18RR",
  "tie_handling": "rounded_mean_rank",
  "tie_rtol": 0.0001,
  "tie_atol": 1e-05,
  "epoch_per_eval": 5,
  "normalize_lp_scores": true,
  "lp_score_mode": "cosine",
  "lp_distance_degree": 2,
  "valid_metric": "cosine",
  "uniform_pair_chunk_size": 256
}
